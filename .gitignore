# Python
__pycache__/
*.pyc

# Training / runtime output
*.log
*.err
*.out

# Large model weights and checkpoints (exceed GitHub's 100 MB limit)
*.pt
amp-portal/src/server/python/esmc_embed_cache.pkl
amp-portal/src/server/python/flm_final_epoch_checkpoint/

# Old model / data backups
*_backup/
*_backup.pkl

# Office lock files
~$*

# Secrets (API keys) — never commit
.env
**/.env

# Slide decks and posters stay local
*.ppt
*.pptx

# Training runtime leftovers
*.pid
*_backup.json

# Reports and papers stay local
*.docx
*.pdf

# Per-machine watchdog settings (written by deploy/setup_server.ps1)
portal.settings.json

# Server bundle (model weights, search tools) made by deploy/make_bundle.ps1
ADAM2_server_bundle/

# AlphaFold archives (about 200 MB): the Clustering List reads its 3D
# structures for clusters 31-136 from them (alphafold_archive.js).
AlphaFold/
# ESMFold archive (1.1 GB, over GitHub's file limit); no longer used by the site.
esmfold/

# Runtime logs from portal-service.ps1
logs/

# Feedback backup: visitors' names, emails and messages. Never commit it;
# submissions also go to the team's Google Form. server.js creates it.
amp-portal/src/server/feedback.json
