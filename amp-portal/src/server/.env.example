# Copy this file to .env (same folder) and fill in ONE key below.
# .env is ignored by Git, so your key never leaves this computer.
# Restart the backend after changing it.

# Which AI the help assistant uses: grok, groq or gemini.
AI_PROVIDER=grok

# grok  -> xAI Grok. Key from https://console.x.ai  ("API Keys").
XAI_API_KEY=

# groq  -> Groq (free plan). Key from https://console.groq.com/keys
GROQ_API_KEY= 

# gemini -> Google Gemini (free plan). Key from https://aistudio.google.com  ("Get API key").
GEMINI_API_KEY=

# Optional: a different model name for the chosen provider.
# Defaults: grok-3-mini (grok), qwen/qwen3.8-27b (groq), gemini-2.5-flash (gemini).
AI_MODEL=

# Support email shown when a question is not about ADAM or AMPs (default abc@efg.com)
CONTACT_EMAIL=
